# ============================================
# Variables d'Environnement - IA Réceptionniste
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs

# ============================================
# API OpenAI (REQUIS)
# ============================================
OPENAI_API_KEY=sk-your-api-key-here

# ============================================
# Configuration Vite (Frontend)
# ============================================
# URL de base de l'API (pour le développement local)
VITE_API_BASE_URL=/.netlify/functions

# Mode debug (affiche les logs dans la console)
VITE_DEBUG=false

# ============================================
# Configuration Netlify (Backend)
# ============================================
# Modèle OpenAI pour le chat
OPENAI_MODEL=gpt-4o-mini

# Modèle OpenAI pour la synthèse vocale
OPENAI_TTS_MODEL=tts-1-hd

# ============================================
# Notes
# ============================================
# - Ne jamais committer le fichier .env avec votre vraie clé API
# - Utilisez Netlify Environment Variables pour la production
# - Les variables VITE_* sont exposées au frontend
